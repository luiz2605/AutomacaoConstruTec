# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca comite senha.
# No Render estas variáveis são cadastradas no painel, não neste arquivo.

# Login da aplicação web (HTTP Basic). Use senha só com caracteres ASCII:
# o cabeçalho Basic é transportado em ASCII, e uma senha acentuada nunca chega
# inteira ao servidor.
ORCAUTO_USUARIO=orcamentos
ORCAUTO_SENHA=troque-esta-senha

# Opcionais
# ORCAUTO_MAX_MB=40                       # limite do PDF enviado
# ORCAUTO_BASE_XLSX=/caminho/PLANILHA_BASE.xlsx
# ORCAUTO_CONFIG=/caminho/config.toml

# Relato de problema pela tela (SMTP). Sem estas cinco, o link "Relatar um
# problema" não aparece e a rota /relatar responde 503 — o resto segue normal.
# ORCAUTO_SMTP_HOST=smtp.gmail.com
# ORCAUTO_SMTP_PORTA=465
# ORCAUTO_SMTP_USUARIO=orcauto@construtec.com.br
# ORCAUTO_SMTP_SENHA=senha-de-app-do-provedor
# ORCAUTO_EMAIL_SUPORTE=suporte@construtec.com.br
